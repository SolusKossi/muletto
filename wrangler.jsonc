// Cloudflare: the site as static assets, with no Worker code at all.
//
// Moved here from Vercel on 2026-10-15 after the project was paused twice for
// running out of function processor time. Nothing a visitor uses runs on a
// server, and static requests here are not metered against any allowance.
//
// html_handling "none" is the setting that matters. The default strips .html
// and redirects /guides.html to /guides, and every canonical link, og:url and
// sitemap entry on this site names the .html address - a canonical that
// redirects is the one thing a canonical must not do.
//
// _headers (the Content-Security-Policy) and _redirects in apps/web are read
// from the assets directory as they are.
//
// worker/index.js runs for /api/* and nothing else (run_worker_first), so
// every page is still served without running code - the counter and the
// owner-only stats are the only two things that do.
{
  "name": "muletto",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // The domain lives here rather than in the dashboard, so a redeploy cannot
  // lose it and a fork's deploy cannot claim it by accident without editing.
  "routes": [
    { "pattern": "muletto.app", "custom_domain": true },
    { "pattern": "www.muletto.app", "custom_domain": true }
  ],
  // Daily counts. No id: wrangler creates the namespace on first deploy.
  "kv_namespaces": [{ "binding": "COUNTS" }],
  // The admin key's hash is a secret set in the dashboard (Worker, Settings,
  // Variables and Secrets: ADMIN_KEY_HASH), never written here - this file is
  // public. Generate it with node tools/admin-key.js.
  "keep_vars": true
}
